<mujoco model="wheeled titatit stair scene">
  <include file="wheeled_titatit_rl.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane"
             builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="2 0.02 0.002"/>

    <!-- Training stairs use about 0.30-0.34m step width; keep this low first. -->
    <body name="low_stairs" pos="3.80 0 0">
      <geom name="stair_05_1" type="box" pos="0.15 0 0.025" size="0.15 1.60 0.025" friction="2 0.02 0.002"/>
      <geom name="stair_05_2" type="box" pos="0.45 0 0.050" size="0.15 1.60 0.050" friction="2 0.02 0.002"/>
      <geom name="stair_05_3" type="box" pos="0.75 0 0.075" size="0.15 1.60 0.075" friction="2 0.02 0.002"/>
      <geom name="stair_05_4" type="box" pos="1.05 0 0.100" size="0.15 1.60 0.100" friction="2 0.02 0.002"/>
    </body>
  </worldbody>
</mujoco>
