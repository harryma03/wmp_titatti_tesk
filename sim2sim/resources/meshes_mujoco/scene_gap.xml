<mujoco model="wheeled titatit gap scene">
  <include file="wheeled_titatit_rl.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane"
             builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- Box runways leave real empty gaps; no infinite plane underneath.
         Top surface is z=0. Gap sequence is 10/16/24/30 cm with enough landing room. -->
    <geom name="gap_start_runway" type="box" pos="1.50 0 -0.03" size="2.50 1.80 0.03" material="groundplane" friction="1.2 0.02 0.002"/>
    <geom name="gap_landing_after_10cm" type="box" pos="4.85 0 -0.03" size="0.75 1.80 0.03" material="groundplane" friction="1.2 0.02 0.002"/>
    <geom name="gap_landing_after_16cm" type="box" pos="6.51 0 -0.03" size="0.75 1.80 0.03" material="groundplane" friction="1.2 0.02 0.002"/>
    <geom name="gap_landing_after_24cm" type="box" pos="8.25 0 -0.03" size="0.75 1.80 0.03" material="groundplane" friction="1.2 0.02 0.002"/>
    <geom name="gap_exit_after_30cm" type="box" pos="11.65 0 -0.03" size="2.35 1.80 0.03" material="groundplane" friction="1.2 0.02 0.002"/>
  </worldbody>
</mujoco>
